# =============================================================================
# Assamese AI Voice Agent Platform — Root Environment Template
# =============================================================================

# --- Local Docker Infrastructure (₹0 local development) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=voice_agent
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- LiveKit Realtime Media (dev mode — no TLS) ---
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_URL=http://localhost:7880

# =============================================================================
# Backend (backend/.env)
# =============================================================================
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voice_agent
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-min-32-chars
JWT_REFRESH_EXPIRATION=7d

# --- Python TTS Service (AI4Bharat IndicF5) ---
TTS_SERVICE_URL=http://localhost:8001

# --- Speech-to-Text (Deepgram Cloud API - Assamese support) ---
DEEPGRAM_API_KEY=

# --- LLM (External Hugging Face Inference Providers - DO NOT run in local Docker) ---
# Hugging Face provides ₹0 cloud inference for open-source models like Qwen3.5-4B
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_MODEL=Qwen/Qwen3.5-4B

# --- Web Dashboard CORS ---
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# Frontend Dashboard (frontend/.env.local)
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
