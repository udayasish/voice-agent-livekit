{
  "name": "voice-agent-backend",
  "version": "1.0.0",
  "description": "Assamese AI Voice Agent Platform - Backend & AI Engine",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --env-file .env src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate": "tsx node_modules/drizzle-kit/bin.cjs migrate",
    "db:generate": "tsx node_modules/drizzle-kit/bin.cjs generate",
    "db:studio": "tsx node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "tsx --env-file .env src/lib/db/seed.ts",
    "test:auth": "tsx --env-file .env test/auth.test.ts",
    "test:livekit": "tsx --env-file .env test/livekit.test.ts",
    "test:agent": "tsx --env-file .env test/agent.test.ts",
    "test:agent:e2e": "tsx --env-file .env test/agent-e2e.test.ts",
    "test:vad": "tsx --env-file .env test/vad.test.ts",
    "test:stt": "tsx --env-file .env test/stt.test.ts",
    "test:benchmark": "tsx --test test/benchmark.test.ts",
    "benchmark:stt": "tsx --env-file .env test/benchmark/runner.ts",
    "agent:dev": "tsx --env-file .env src/agent/index.ts dev",
    "agent:start": "node --env-file .env dist/agent/index.js start"
  },
  "dependencies": {
    "@livekit/agents": "^1.9.1",
    "@livekit/agents-plugin-deepgram": "^1.9.1",
    "@livekit/agents-plugin-silero": "^1.9.1",
    "@livekit/rtc-node": "^1.1.0",
    "@openai/agents": "^0.8.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "express": "^5.0.1",
    "jose": "^6.0.11",
    "livekit-server-sdk": "^2.13.0",
    "pg": "^8.13.1",
    "redis": "^4.7.0",
    "winston": "^3.17.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
