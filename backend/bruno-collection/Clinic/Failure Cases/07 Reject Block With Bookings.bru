meta {
  name: Reject Block With Bookings
  type: http
  seq: 7
}

post {
  url: {{host}}/api/v1/doctors/{{doctorId}}/blocked-dates
  body: json
  auth: bearer
}

headers {
  x-organization-id: {{organizationId}}
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "date": "{{clinicDate}}"
  }
}

script:post-response {
  if (res.status === 409 && res.body.success) {  }
}

tests {
  test("Expected HTTP status", function () { expect(res.status).to.equal(409); });
  test("Standard envelope", function () { expect(res.body.success).to.equal(false); expect(res.body.error.code).to.be.a("string"); expect(res.body.error.message).to.be.a("string"); });
}

docs {
