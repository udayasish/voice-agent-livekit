meta {
  name: Reject Stale Version
  type: http
  seq: 10
}

patch {
  url: {{host}}/api/v1/appointments/{{appointmentId}}
  body: json
  auth: bearer
}

headers {
  x-organization-id: {{organizationId}}
  Idempotency-Key: {{requestKey}}
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "action": "cancel",
    "expectedVersion": 1,
    "reason": "Synthetic cancellation"
  }
}

script:pre-request {
  bru.setVar("requestKey", require("uuid").v4());
}

script:post-response {
  if (res.status === 409 && res.body.success) {  }
}

tests {
  test("Expected HTTP status", function () { expect(res.status).to.equal(409); });
  test("Standard envelope", function () { expect(res.body.success).to.equal(false); expect(res.body.error.code).to.be.a("string"); expect(res.body.error.message).to.be.a("string"); });
}

docs {
  Synthetic local clinic data only. See Clinic/README.md for prerequisites and ordered acceptance.
}
