meta {
  name: List Slots
  type: http
  seq: 6
}

get {
  url: {{host}}/api/v1/doctors/{{doctorId}}/slots?from={{clinicDate}}&to={{clinicDate}}&pageSize=20
  body: none
  auth: bearer
}

headers {
  x-organization-id: {{organizationId}}
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.status === 200 && res.body.success) { const slots = res.body.data.items; bru.setVar("slotId", slots[0].id); bru.setVar("targetSlotId", slots[1].id); bru.setVar("emptySlotId", slots[3].id); }
}

tests {
  test("Expected HTTP status", function () { expect(res.status).to.equal(200); });
  test("Standard envelope", function () { expect(res.body.success).to.equal(true); expect(res.body).to.have.property("data"); });
}

docs {
  Synthetic local clinic data only. See Clinic/README.md for prerequisites and ordered acceptance.
}
