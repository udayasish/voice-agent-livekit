meta {
  name: Block Cleared Date
  type: http
  seq: 16
}

post {
  url: {{host}}/api/v1/doctors/{{doctorId}}/blocked-dates
  body: json
  auth: bearer
}

headers {
  x-organization-id: {{organizationId}}
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "date": "{{clinicDate}}",
    "reason": "leave"
  }
}

script:post-response {
  if (res.status === 200 && res.body.success) { bru.setVar("blockedDateId", res.body.data.blockedDateId); }
}

tests {
  test("Expected HTTP status", function () { expect(res.status).to.equal(200); });
  test("Standard envelope", function () { expect(res.body.success).to.equal(true); expect(res.body).to.have.property("data"); });
}

docs {
  Synthetic local clinic data only. See Clinic/README.md for prerequisites and ordered acceptance.
}
