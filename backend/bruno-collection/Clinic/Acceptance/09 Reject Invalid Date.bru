}

get {
  url: {{host}}/api/v1/doctors/{{doctorId}}/available-times?date=2026-02-30
  body: none
  auth: bearer
}

headers {
  x-organization-id: {{organizationId}}
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.status === 400 && res.body.success) {  }
}

tests {
  test("Expected HTTP status", function () { expect(res.status).to.equal(400); });
  test("Standard envelope", function () { expect(res.body.success).to.equal(false); expect(res.body.error.code).to.be.a("string"); expect(res.body.error.message).to.be.a("string"); });
}

