meta {
  name: Login Staff
  type: http
  seq: 1
}

post {
  url: {{host}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  x-organization-id: {{organizationId}}
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body.success) { bru.setVar("accessToken", res.body.data.accessToken); bru.setVar("organizationId", res.body.data.currentOrganization.id); }
}

tests {
  test("Expected HTTP status", function () { expect(res.status).to.equal(200); });
  test("Standard envelope", function () { expect(res.body.success).to.equal(true); expect(res.body).to.have.property("data"); });
}

docs {
  Synthetic local clinic data only. See Clinic/README.md for prerequisites and ordered acceptance.
}
