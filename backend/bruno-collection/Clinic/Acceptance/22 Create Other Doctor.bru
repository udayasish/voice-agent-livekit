meta {
  name: Create Other Doctor
  type: http
  seq: 22
}

post {
  url: {{host}}/api/v1/doctors
  body: json
  auth: bearer
}

headers {
  x-organization-id: {{organizationId}}
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Other Synthetic Doctor",
    "phoneNumber": "{{otherDoctorPhone}}"
  }
}

script:pre-request {
  bru.setVar("otherDoctorPhone", "8" + String(Date.now()).slice(-9));
}

script:post-response {
  if (res.status === 201 && res.body.success) { bru.setVar("otherDoctorId", res.body.data.id); }
}

tests {
  test("Expected HTTP status", function () { expect(res.status).to.equal(201); });
  test("Standard envelope", function () { expect(res.body.success).to.equal(true); expect(res.body).to.have.property("data"); });
}

docs {
  Synthetic local clinic data only. See Clinic/README.md for prerequisites and ordered acceptance.
}
