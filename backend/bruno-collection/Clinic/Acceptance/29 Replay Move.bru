meta {
  name: Replay Move
  type: http
  seq: 29
}

patch {
  url: {{host}}/api/v1/appointments/{{appointmentId}}
  body: json
  auth: bearer
}

headers {
  x-organization-id: {{organizationId}}
  Idempotency-Key: {{moveKey}}
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "action": "reschedule",
    "expectedVersion": {{moveExpectedVersion}},
    "targetSlotId": "{{targetSlotId}}",
    "reason": "Synthetic later time"
  }
}

script:post-response {
  if (res.status === 200 && res.body.success) {  }
}

tests {
  test("Expected HTTP status", function () { expect(res.status).to.equal(200); });
  test("Standard envelope", function () { expect(res.body.success).to.equal(true); expect(res.body).to.have.property("data"); });
  test("Business result", function () { expect(res.body.data.replayed).to.equal(true); });
}

docs {
  Synthetic local clinic data only. See Clinic/README.md for prerequisites and ordered acceptance.
}
