meta {
  name: Book Appointment
  type: http
  seq: 16
}

post {
  url: {{host}}/api/v1/appointments
  body: json
  auth: bearer
}

headers {
  x-organization-id: {{organizationId}}
  Idempotency-Key: {{requestKey}}
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "doctorId": "{{doctorId}}",
    "patientId": "{{patientId}}",
    "slotId": "{{slotId}}",
    "patientName": "Synthetic Bruno Patient",
    "patientAge": 27
  }
}

script:pre-request {
  bru.setVar("requestKey", require("uuid").v4());
}

script:post-response {
  if (res.status === 201 && res.body.success) { bru.setVar("appointmentId", res.body.data.appointmentId); bru.setVar("appointmentVersion", res.body.data.version); bru.setVar("bookingKey", bru.getVar("requestKey")); }
}

tests {
  test("Expected HTTP status", function () { expect(res.status).to.equal(201); });
  test("Standard envelope", function () { expect(res.body.success).to.equal(true); expect(res.body).to.have.property("data"); });
}

docs {
  Synthetic local clinic data only. See Clinic/README.md for prerequisites and ordered acceptance.
}
