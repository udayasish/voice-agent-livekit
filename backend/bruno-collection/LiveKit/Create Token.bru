meta {
  name: Create Token
  type: http
  seq: 1
}

post {
  url: {{host}}/api/v1/livekit/token
  body: json
  auth: bearer
}

headers {
  x-organization-id: {{organizationId}}
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "agentId": "{{agentId}}",
    "roomName": "voice-testing-room",
    "participantName": "Test Doctor"
  }
}

script:post-response {
  if (res.body && res.body.success && res.body.data && res.body.data.token) {
    bru.setVar("livekitToken", res.body.data.token);
    bru.setVar("livekitRoom", res.body.data.roomName);
  }
}

docs {
  roomName is a label. Each caller receives a unique organization-scoped room.
  JWT metadata carries only a one-use Redis runtimeBindingId, never tool permissions.
  Run Auth/Login and Agents/Create Agent (or select a saved agentId) first.
  Omit agentId only if an imported default alias exists; absent defaults return AGENT_NOT_AVAILABLE.
  An explicit unconfigured agentId returns AGENT_NOT_AVAILABLE (403).
  Patient accounts are unnecessary; dashboard staff remain authenticated.
}
