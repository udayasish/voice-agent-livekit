meta {
  name: List Agents
  type: http
  seq: 3
}

get {
  url: {{host}}/api/v1/agents?page=1&pageSize=20&active=true
  auth: bearer
}

headers {
  x-organization-id: {{organizationId}}
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("Expected HTTP status", function () { expect(res.status).to.equal(200); });
  test("Standard envelope", function () { expect(res.body.success).to.equal(true); expect(res.body).to.have.property("data"); });
  test("Paginated list", function () { expect(res.body.data.items).to.be.an("array"); expect(res.body.data.pagination.pageSize).to.equal(20); });
}

docs {
  Lists active agents. Remove active=true to include inactive agents.
}
