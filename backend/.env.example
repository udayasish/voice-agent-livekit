NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voice_agent

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-min-32-chars
JWT_REFRESH_EXPIRATION=7d

# LiveKit (dev server)
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# Python TTS
TTS_SERVICE_URL=http://localhost:8001

# Deepgram STT
DEEPGRAM_API_KEY=

# Hugging Face LLM
HUGGINGFACE_API_TOKEN=

# CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
