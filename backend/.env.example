NODE_ENV=development
PORT=4000

# PostgreSQL (Local Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voice_agent

# Redis (Local Docker)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-min-32-chars
JWT_REFRESH_EXPIRATION=7d

# LiveKit (Local Docker dev server)
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# Text-to-Speech (TTS)
TTS_PROVIDER=raya
# Raya BakBak TTS (Cloud API)
RAYA_API_KEY=
RAYA_API_BASE_URL=https://hub.getraya.app/v1
RAYA_TTS_LANGUAGE=as
RAYA_TTS_MODEL=standard
RAYA_TTS_VOICE_ID=
RAYA_TTS_SAMPLE_RATE=24000
RAYA_TTS_SPEED=1.0

# Python IndicF5 TTS (preserved for benchmark comparison)
TTS_SERVICE_URL=http://localhost:8001

# Deepgram STT (Cloud API)
DEEPGRAM_API_KEY=

# LLM (External Hugging Face Inference Providers - DO NOT run in Docker)
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_MODEL=Qwen/Qwen3.5-4B

# CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
